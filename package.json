    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
